PROJECT_NAME           = "TypeSafeRegister"
PROJECT_BRIEF          = "Type-safe CMSIS-SVD register access for C++"
OUTPUT_DIRECTORY       = "@SPHINX_DOXYGEN_DIRECTORY@"
INPUT                  = "@PROJECT_SOURCE_DIR@/include"
FILE_PATTERNS          = *.h
RECURSIVE              = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = NO