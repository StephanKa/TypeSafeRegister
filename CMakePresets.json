{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug/${presetName}",
      "displayName": "Base preset for debug builds",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_COVERAGE": "ON",
        "ENABLE_SANITIZER_ADDRESS": "ON",
        "ENABLE_SANITIZER_LEAK": "ON",
        "ENABLE_SANITIZER_UNDEFINED_BEHAVIOR": "ON",
        "ENABLE_SANITIZER_MEMORY": "OFF",
        "ENABLE_OUTPUT": "ON"
      }
    },
    {
      "name": "release-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release/${presetName}",
      "displayName": "Base preset for release builds",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_OUTPUT": "ON"
      }
    },
    {
      "name": "clang-20-debug",
      "inherits": "debug-base",
      "displayName": "Preset for clang 20 debug build",
      "environment": {
        "CXX": "clang++-20",
        "CC": "clang-20"
      }
    },
    {
      "name": "clang-20-release",
      "inherits": "release-base",
      "displayName": "Preset for clang 20 release build",
      "environment": {
        "CXX": "clang++-20",
        "CC": "clang-20"
      }
    },
    {
      "name": "clang-21-debug",
      "inherits": "debug-base",
      "displayName": "Preset for clang 21 debug build",
      "environment": {
        "CXX": "clang++-21",
        "CC": "clang-21"
      }
    },
    {
      "name": "clang-21-release",
      "inherits": "release-base",
      "displayName": "Preset for clang 21 release build",
      "environment": {
        "CXX": "clang++-21",
        "CC": "clang-21"
      }
    },
    {
      "name": "clang-22-debug",
      "inherits": "debug-base",
      "displayName": "Preset for clang 22 debug build",
      "environment": {
        "CXX": "clang++-22",
        "CC": "clang-22"
      }
    },
    {
      "name": "clang-22-release",
      "inherits": "release-base",
      "displayName": "Preset for clang 22 release build",
      "environment": {
        "CXX": "clang++-22",
        "CC": "clang-22"
      }
    },
    {
      "name": "gcc-14-debug",
      "inherits": "debug-base",
      "displayName": "Preset for gcc 14 debug builds",
      "environment": {
        "CXX": "g++-14",
        "CC": "gcc-14"
      }
    },
    {
      "name": "gcc-14-release",
      "inherits": "release-base",
      "displayName": "Preset for gcc 14 release builds",
      "environment": {
        "CXX": "g++-14",
        "CC": "gcc-14"
      }
    },
    {
      "name": "gcc-15-debug",
      "inherits": "debug-base",
      "displayName": "Preset for gcc 15 debug builds",
      "environment": {
        "CXX": "g++-15",
        "CC": "gcc-15"
      }
    },
    {
      "name": "gcc-15-release",
      "inherits": "release-base",
      "displayName": "Preset for gcc 15 release builds",
      "environment": {
        "CXX": "g++-15",
        "CC": "gcc-15"
      }
    },
    {
      "name": "gcc-16-debug",
      "inherits": "debug-base",
      "displayName": "Preset for gcc 16 debug builds",
      "environment": {
        "CXX": "g++-16",
        "CC": "gcc-16"
      }
    },
    {
      "name": "gcc-16-release",
      "inherits": "release-base",
      "displayName": "Preset for gcc 16 release builds",
      "environment": {
        "CXX": "g++-16",
        "CC": "gcc-16"
      }
    },
    {
      "name": "windows-2019-debug",
      "displayName": "Windows x64 Debug",
      "generator": "Visual Studio 16 2019",
      "binaryDir": "${sourceDir}/build/debug/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_OUTPUT": "ON"
      }
    },
    {
      "name": "windows-2019-release",
      "displayName": "Windows x64 release",
      "generator": "Visual Studio 16 2019",
      "binaryDir": "${sourceDir}/build/release/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_OUTPUT": "ON"
      }
    },
    {
      "name": "windows-2022-debug",
      "displayName": "Windows x64 Debug",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/debug/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_OUTPUT": "ON"
      }
    },
    {
      "name": "windows-2022-release",
      "displayName": "Windows x64 release",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/release/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_OUTPUT": "ON"
      }
    },
    {
      "name": "win32-gcc-x64-mingw-debug",
      "displayName": "Windows GCC x64 (MinGW Makefiles) Debug",
      "description": "Using GCC x64 compiler with Ninja generator on Windows - Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug/${presetName}",
      "environment": {
        "PATH": "C:/msys64/mingw64/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc.exe",
        "CMAKE_CXX_COMPILER": "g++.exe",
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_OUTPUT": "ON"
      }
    },
    {
      "name": "win32-gcc-x64-mingw-release",
      "displayName": "Windows GCC x64 (MinGW Makefiles) Release",
      "description": "Using GCC x64 compiler with Ninja generator on Windows - Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release/${presetName}",
      "environment": {
        "PATH": "C:/msys64/mingw64/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc.exe",
        "CMAKE_CXX_COMPILER": "g++.exe",
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_OUTPUT": "ON"
      }
    },
    {
      "name": "clang-22-debug-static-analysis",
      "displayName": "Clang 22 Debug - Static Analysis",
      "description": "Target Unix-like OS with the Clang 22 compiler, debug build type",
      "inherits": "clang-22-debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-22",
        "CMAKE_CXX_COMPILER": "clang++-22",
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_CPPCHECK": "ON",
        "ENABLE_CLANG_TIDY": "ON",
        "ENABLE_INCLUDE_WHAT_YOU_USE": "ON",
        "ENABLE_COVERAGE": "OFF",
        "ENABLE_SANITIZER_ADDRESS": "OFF",
        "ENABLE_SANITIZER_LEAK": "OFF",
        "ENABLE_SANITIZER_UNDEFINED_BEHAVIOR": "OFF",
        "ENABLE_SANITIZER_MEMORY": "OFF"
      }
    },
    {
      "name": "gcc-arm-debug",
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/arm-cortex-gnu/ArmCortexM4Gnu.cmake",
      "binaryDir": "${sourceDir}/build/debug/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "armv7l",
        "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY",
        "CMAKE_CROSSCOMPILING": "TRUE"
      }
    },
    {
      "name": "gcc-arm-release",
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/arm-cortex-gnu/ArmCortexM4Gnu.cmake",
      "binaryDir": "${sourceDir}/build/release/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "armv7l",
        "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY",
        "CMAKE_CROSSCOMPILING": "TRUE"
      }
    }
  ],
