#pragma once

#include <array>
#include <BitField.h>
#include <EnumeratedField.h>
#include <Register.h>
#include <RegisterArray.h>
#include <SvdTypes.h>

namespace {{ peripheral.identifier }}
{
    /** @brief Distinguishes field descriptors owned by this peripheral. */
    struct PeripheralTag
    {
    };

    /** @brief Base address declared for this peripheral by the SVD. */
    inline constexpr std::uintptr_t base_address = 0x{{ "%x" | format(peripheral.base_address) }}U;

{% for register in peripheral.registers %}
    namespace {{ register.identifier }}_Fields
    {
{% if register.fields | selectattr('enum_values') | list | length > 0 %}
        namespace Enums
        {
{% for field in register.fields if field.enum_values %}
            enum class {{ field.identifier }} : {{ register.width_type }}
            {
{% for value in field.enum_values %}
                {{ value.identifier }} = {{ value.value }},
{% endfor %}
            };
{% endfor %}
        }// namespace Enums
{% endif %}
{% for field in register.fields %}
        // Bit {{ field.offset }}{% if field.width > 1 %} - {{ field.offset + field.width - 1 }}{% endif %}: {{ field.description }}
{% if field.enum_values %}
        inline constexpr auto {{ field.identifier }} = EnumeratedField<Enums::{{ field.identifier }}, {{ field.offset }}, {{ field.width }}, "{{ field.identifier }}", {{ field.access }}, {{ field.register_width_type }}, {{ field.modified_write_value }}, {{ field.read_action }}>{};
{% else %}
    inline constexpr auto {{ field.identifier }} = BitField<PeripheralTag, {{ field.offset }}, {{ field.width }}, "{{ field.identifier }}", {{ field.access }}, {{ field.register_width_type }}, {{ field.modified_write_value }}, {{ field.read_action }}>{};
{% endif %}
        static_assert({{ field.identifier }}.mask == details::getMask<{{ field.register_width_type }}>({{ field.offset }}, {{ field.width }}));
{% endfor %}
    }// namespace {{ register.identifier }}_Fields

    /** @brief {{ register.description }} */
    inline Register<{{ register.width_type }}, base_address + 0x{{ "%x" | format(register.offset) }}U, 0x{{ "%x" | format(register.reset_value) }}U, {{ register.access }}, "{{ register.identifier }}"
{% for field in register.fields %}
        , decltype({{ register.identifier }}_Fields::{{ field.identifier }})
{% endfor %}> {{ register.identifier }}{};
{% endfor %}

{% for array in peripheral.arrays %}
    namespace {{ array.identifier }}_Fields
    {
{% if array.fields | selectattr('enum_values') | list | length > 0 %}
    namespace Enums
    {
{% for field in array.fields if field.enum_values %}
        enum class {{ field.identifier }} : {{ array.width_type }}
        {
{% for value in field.enum_values %}
        {{ value.identifier }} = {{ value.value }},
{% endfor %}
        };
{% endfor %}
    }// namespace Enums
{% endif %}
{% for field in array.fields %}
{% if field.enum_values %}
    inline constexpr auto {{ field.identifier }} = EnumeratedField<Enums::{{ field.identifier }}, {{ field.offset }}, {{ field.width }}, "{{ field.identifier }}", {{ field.access }}, {{ field.register_width_type }}, {{ field.modified_write_value }}, {{ field.read_action }}>{};
{% else %}
    inline constexpr auto {{ field.identifier }} = BitField<PeripheralTag, {{ field.offset }}, {{ field.width }}, "{{ field.identifier }}", {{ field.access }}, {{ field.register_width_type }}, {{ field.modified_write_value }}, {{ field.read_action }}>{};
{% endif %}
{% endfor %}
    }// namespace {{ array.identifier }}_Fields

    inline constexpr RegisterArray<{{ array.width_type }}, base_address + 0x{{ "%x" | format(array.offset) }}U, 0x{{ "%x" | format(array.reset_value) }}U, {{ array.access }}, "{{ array.identifier }}", {{ array.count }}, 0x{{ "%x" | format(array.increment) }}U
{% for field in array.fields %}
        , decltype({{ array.identifier }}_Fields::{{ field.identifier }})
{% endfor %}> {{ array.identifier }}{};
{% endfor %}

    /** @brief Metadata for registers declared by this peripheral. */
    inline constexpr std::array<details::RegisterInfo, {{ peripheral.registers | length }}> register_info{
{% for register in peripheral.registers %}
        details::RegisterInfo{ "{{ register.name }}", {{ register.description | cpp_string }}, base_address + 0x{{ "%x" | format(register.offset) }}U, 0x{{ "%x" | format(register.reset_value) }}U, {{ register.width }}, {{ register.metadata_access }}, {{ register.modified_write_value }}, {{ register.read_action }} },
{% endfor %}
    };

    /** @brief Address ranges declared by the SVD. */
    inline constexpr std::array<details::AddressBlockInfo, {{ peripheral.address_blocks | length }}> address_blocks{
{% for address_block in peripheral.address_blocks %}
        details::AddressBlockInfo{ base_address + 0x{{ "%x" | format(address_block.offset) }}U, 0x{{ "%x" | format(address_block.size) }}U, {{ address_block.usage | cpp_string }} },
{% endfor %}
    };

{% if peripheral.interrupts %}
    /** @brief Interrupt numbers associated with this peripheral. */
    enum class Interrupt : std::int32_t
    {
{% for interrupt in peripheral.interrupts %}
        {{ interrupt.identifier }} = {{ interrupt.value }},
{% endfor %}
    };
{% endif %}
    /** @brief Metadata for interrupts associated with this peripheral. */
    inline constexpr std::array<details::InterruptInfo, {{ peripheral.interrupts | length }}> interrupt_info{
{% for interrupt in peripheral.interrupts %}
        details::InterruptInfo{ "{{ interrupt.name }}", {{ interrupt.description | cpp_string }}, {{ interrupt.value }} },
{% endfor %}
    };

    /** @brief Metadata declared for this peripheral by the SVD. */
    inline constexpr details::PeripheralInfo info{
        "{{ peripheral.name }}", {{ peripheral.description | cpp_string }}, {{ peripheral.group_name | cpp_string }}, base_address, register_info.size()
    };
}// namespace {{ peripheral.identifier }}